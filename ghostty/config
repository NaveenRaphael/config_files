gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-single-instance = true
window-subtitle = working-directory
# title = "ghostty"
# shell-integration-features = "title"

theme = catppuccin-mocha
keybind = ctrl+t=new_tab
keybind = ctrl+shift+d=close_surface

# jump to tab
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8


# splits
keybind = ctrl+equal=new_split:down
keybind = ctrl+minus=unbind
keybind = ctrl+backslash=new_split:right
keybind = ctrl+up=goto_split:top
keybind = ctrl+down=goto_split:bottom
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+shift+up=resize_split:up,5
keybind = ctrl+shift+down=resize_split:down,5
keybind = ctrl+shift+left=resize_split:left,5
keybind = ctrl+shift+right=resize_split:right,5
