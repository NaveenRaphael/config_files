mce() {
    if [ $# -eq 0 ]; then
        echo "Usage: mce <environment_name> <python_version>"
        echo "Create a new mamba environment with specified Python version"
        echo ""
        echo "Arguments:"
        echo "  environment_name  Name for the new conda environment"
        echo "  python_version    Python version (e.g., 3.9, 3.10, 3.11)"
        echo ""
        echo "Example:"
        echo "  mce myenv 3.10"
        return 1
    fi
    mamba create -n "$1$2" python=$2
}
