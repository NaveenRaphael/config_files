# ...

# zoxide init
eval "$(zoxide init bash --cmd cd)"

[ -f ~/.fzf.bash ] && source ~/.fzf.bash

. "$HOME/.cargo/env"

export EDITOR="hx"
export HELIX_RUNTIME=/home/naveen/Documents/Naveen/helix/runtime

disk_usage_ok() {
    local min_gb=${1:-5}
    # Use -k for KB output (most portable), then convert to GB
    local available_kb=$(df -k / | awk 'NR==2 {print $4}')
    local available_gb=$((available_kb / 1024 / 1024))
    [ "$available_gb" -ge "$min_gb" ]
}

# Commands generated by llms
# Conditional commands based on disk usage
if disk_usage_ok 2; then
    # Normal operations - less than 2 GB free
    # Set up fzf key bindings and fuzzy completion
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
    eval "$(fzf --bash)"

    # >>> mamba initialize >>>
    # !! Contents within this block are managed by 'mamba shell init' !!
    export MAMBA_EXE='/home/naveen/miniforge3/bin/mamba';
    export MAMBA_ROOT_PREFIX='/home/naveen/miniforge3';
    __mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__mamba_setup"
    else
        alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
    fi
    unset __mamba_setup
    mamba activate base
    export PATH="/home/naveen/.pixi/bin:$PATH"

    . ~/.just.bash

    function set_win_title(){
        echo -ne "\033]0;ghostty $(basename "$PWD") \007"
    }

    eval "$(starship init bash)"
    starship_precmd_user_func="set_win_title"

    . "/home/naveen/.deno/env"

    # xmodmap -e 'keycode 0x6c = Caps_Lock'
    # xmodmap -e "remove lock = Caps_Lock"
    # xmodmap -e 'keycode 0x42 = Tab'
    export PATH=~/opensim-core/bin:$PATH
    export PATH=$HOME/.atuin/bin:$PATH

    source ~/.local/share/blesh/ble.sh
    bleopt complete_ambiguous=

    # [[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh
    eval "$(atuin init bash)"
    eval "$(zoxide init bash --cmd cd)"
    eval "$(pixi completion --shell bash)"
    source ~/.dufs_completions.bash
else
    # Minimal setup - disk usage 75% or higher
    echo "Not enough storage"
   
fi
