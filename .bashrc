serve_files(){
        # Check if pattern argument is provided
    if [ $# -eq 0 ]; then
        echo "Usage: serve_files <file_pattern>"
        echo "Example: serve_files '*'"
        return 1
    fi

    PATTERN="$1"
    TEMP_DIR="$HOME/server_folder"

    # Create temporary folder if it doesn't exist
    if [ ! -d "$TEMP_DIR" ]; then
        echo "Creating temporary directory: $TEMP_DIR"
        mkdir -p "$TEMP_DIR"
    else
        echo "Temporary directory already exists: $TEMP_DIR"
    fi

    # Delete all files inside the temporary folder
    echo "Cleaning temporary directory..."
    rm -rf "$TEMP_DIR"/*

    echo "Copying files matching pattern: $PATTERN (case-insensitive)"
    echo "Searching in: ~/Zotero/storage/"
    
    # Use find with case-insensitive matching and copy in one go
    files_copied=$(find ~/Zotero/storage -type f -iname "*${PATTERN}*.pdf" -exec ln -s {} "$TEMP_DIR/" \; -print 2>/dev/null)
    
    if [ -n "$files_copied" ]; then
        echo "Files copied!"
        cd "$TEMP_DIR"
        echo "Starting dufs server from $TEMP_DIR..."
        dufs --allow-symlink
    else
        echo "No files matching pattern '$PATTERN' found!"
    fi
}
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
